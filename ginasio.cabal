cabal-version:      2.4
name:               ginasio
version:            0.1.0.0
synopsis:           Sistema de Gestão de Ginásio (Programação Funcional - Fase 1)
build-type:         Simple

common shared
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:    base >=4 && <5

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Model
                      Domain
                      Format
                      SampleData

executable ginasio
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    ginasio

test-suite ginasio-test
    import:           shared
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    ginasio
